{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "workerUids": {
      "$deviceId": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || data.val() === auth.uid)",
        ".write": false
      }
    },
    "workers": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$deviceId": {
        ".write": "auth != null && root.child('workerUids').child($deviceId).val() === auth.uid"
      }
    },
    "bots": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "workerTasks": {
      "$deviceId": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('workerUids').child($deviceId).val() === auth.uid)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "clusterServers": {
      ".read": "auth != null",
      "$serverId": {
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
        "last_seen": {
          ".write": "auth != null && data.parent().child('uid').val() === auth.uid"
        },
        "status": {
          ".write": "auth != null && data.parent().child('uid').val() === auth.uid"
        },
        "url": {
          ".write": "auth != null && data.parent().child('uid').val() === auth.uid"
        },
        "cluster_id": {
          ".write": "auth != null && data.parent().child('uid').val() === auth.uid"
        }
      }
    },
    "clusterSettings": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "queue": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "workerCommands": {
      "$deviceId": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('workerUids').child($deviceId).val() === auth.uid)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('workerUids').child($deviceId).val() === auth.uid)"
      }
    },
    "workerResults": {
      "$deviceId": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('workerUids').child($deviceId).val() === auth.uid)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('workerUids').child($deviceId).val() === auth.uid)"
      }
    }
  }
}
